{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>konflux-ci/mintmaker//config/renovate/renovate.json"
  ],
  "schedule": [
    "before 7am on Monday"
  ],
  "baseBranchPatterns": [
    "main",
    "release-1.11"
  ],
  "addLabels": [
    "konflux",
    "mintmaker"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.tekton/.*\\.yaml$/"
      ],
      "matchStrings": ["KARGO_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "akuity/kargo",
      "datasourceTemplate": "github-tags"
    }
  ],
  "tekton": {
    "packageRules": [
      {
        "description": "release-1.11: no Konflux reference updates (rebase from main instead)",
        "matchBaseBranches": ["release-1.11"],
        "enabled": false
      }
    ]
  },
  "dockerfile": {
    "packageRules": [
      {
        "description": "release-1.11: no image digest updates (rebase from main instead)",
        "matchBaseBranches": ["release-1.11"],
        "enabled": false
      }
    ]
  },
  "github-actions": {
    "packageRules": [
      {
        "description": "release-1.11: no GitHub Actions updates (rebase from main instead)",
        "matchBaseBranches": ["release-1.11"],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "description": "Go toolchain updates — deptriage defers approval until CI passes",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "/go-toolset/"
      ]
    },
    {
      "description": "Prioritize Konflux tekton task reference updates",
      "matchManagers": [
        "tekton"
      ],
      "matchBaseBranches": ["main"],
      "prPriority": 10
    },
    {
      "description": "Never bump kargo across minor/major (main tracks git tip; release stays on patch line)",
      "matchDepNames": ["kargo", "akuity/kargo"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Group kargo patch updates",
      "matchDepNames": ["kargo", "akuity/kargo"],
      "matchUpdateTypes": ["patch"],
      "enabled": true,
      "groupName": "kargo-version"
    },
    {
      "description": "release-1.11: disable all updates (images, tekton refs, actions, etc.)",
      "matchBaseBranches": ["release-1.11"],
      "enabled": false
    },
    {
      "description": "release-1.11: re-enable kargo patch updates only",
      "matchBaseBranches": ["release-1.11"],
      "matchDepNames": ["kargo", "akuity/kargo"],
      "matchUpdateTypes": ["patch"],
      "enabled": true,
      "groupName": "kargo-version"
    },
    {
      "description": "release-1.11: restrict kargo to 1.11.x (e.g. v1.11.7 → v1.11.8)",
      "matchBaseBranches": ["release-1.11"],
      "matchDepNames": ["kargo", "akuity/kargo"],
      "allowedVersions": "/^v?1\\.11\\./"
    }
  ]
}
