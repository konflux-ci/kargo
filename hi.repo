# Repo IDs from the Hummingbird base image; all are Conforma known RPM repositories.
# See: https://github.com/release-engineering/rhtap-ec-policy/blob/main/data/known_rpm_repositories.yml
[public-hummingbird-$basearch-rpms]
name=public-hummingbird-$basearch-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/$arch/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-hummingbird-release
gpgcheck=1
enabled=1
sslverify=1
priority=10

[public-hummingbird-source-rpms]
name=public-hummingbird-source-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/source/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-hummingbird-release
gpgcheck=1
enabled=1
sslverify=1
priority=10
